<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Configurações | Ella Sorriu</title><link rel="stylesheet" href="/style.css"><script src="/admin.js" defer></script></head>
<body class="admin-page"><%- include('partials/admin-header', { admin, csrfToken, activeSection: 'settings' }) %>
<% const cfg = formValues || settings || {}; const canEdit = ['owner', 'admin'].includes(admin.role); %>
<main class="admin-shell settings-page"><div class="admin-heading"><div><p class="kicker">Preferências</p><h1>Configurações</h1></div></div>
<% if (success) { %><p class="admin-alert admin-alert-success" role="status"><%= success %></p><% } %>
<% if (formError) { %><p class="admin-alert" role="alert"><%= formError %><% if (typeof fieldError !== 'undefined' && fieldError) { %> <%= fieldError %><% } %></p><% } %>
<div class="settings-grid">
<article class="settings-card settings-appearance"><p class="settings-eyebrow">Aparência</p><h2>Visual do painel</h2><p class="settings-description">Estas escolhas ficam salvas somente neste navegador.</p><div class="settings-visual-options">
<div><span class="settings-control-label">Tema</span><div class="theme-selector" role="radiogroup" aria-label="Tema do painel"><button type="button" role="radio" aria-checked="false" data-admin-theme-option="light">Claro</button><button type="button" role="radio" aria-checked="false" data-admin-theme-option="dark">Escuro</button></div></div>
<div><span class="settings-control-label">Densidade</span><div class="theme-selector density-selector" role="radiogroup" aria-label="Densidade do painel"><button type="button" role="radio" aria-checked="false" data-admin-density-option="comfortable">Confortável</button><button type="button" role="radio" aria-checked="false" data-admin-density-option="compact">Compacto</button></div></div></div></article>

<article class="settings-card settings-operations"><p class="settings-eyebrow">Preferências do painel</p><h2>Pedidos do seu jeito</h2><p class="settings-description">Preferências pessoais salvas somente neste navegador.</p>
<div class="settings-preference-group"><span class="settings-control-label">Pedidos por página</span><div class="theme-selector" role="radiogroup" aria-label="Pedidos por página"><button type="button" role="radio" aria-checked="false" data-orders-page-size="10">10</button><button type="button" role="radio" aria-checked="false" data-orders-page-size="20">20</button><button type="button" role="radio" aria-checked="false" data-orders-page-size="50">50</button></div></div>
<div class="settings-preference-group"><span class="settings-control-label">Ordenação</span><div class="theme-selector" role="radiogroup" aria-label="Ordenação dos pedidos"><button type="button" role="radio" aria-checked="false" data-orders-sort="newest">Mais recentes</button><button type="button" role="radio" aria-checked="false" data-orders-sort="oldest">Mais antigos</button></div></div>
<div class="settings-preference-group"><span class="settings-control-label">Atualização automática</span><div class="theme-selector" role="radiogroup" aria-label="Atualização automática dos pedidos"><button type="button" role="radio" aria-checked="false" data-orders-refresh="0">Desativada</button><button type="button" role="radio" aria-checked="false" data-orders-refresh="30">30 s</button><button type="button" role="radio" aria-checked="false" data-orders-refresh="60">60 s</button></div></div></article>

<article class="settings-card settings-clients"><p class="settings-eyebrow">Preferências do painel</p><h2>Clientes do seu jeito</h2><p class="settings-description">A organização escolhida será aplicada à lista de clientes neste navegador.</p>
<div class="settings-preference-group"><span class="settings-control-label">Clientes por página</span><div class="theme-selector" role="radiogroup" aria-label="Clientes por página"><button type="button" role="radio" aria-checked="false" data-clients-page-size="10">10</button><button type="button" role="radio" aria-checked="false" data-clients-page-size="20">20</button><button type="button" role="radio" aria-checked="false" data-clients-page-size="50">50</button></div></div>
<div class="settings-preference-group"><span class="settings-control-label">Ordenação pelo último pedido</span><div class="theme-selector" role="radiogroup" aria-label="Ordenação dos clientes"><button type="button" role="radio" aria-checked="false" data-clients-sort="newest">Mais recentes</button><button type="button" role="radio" aria-checked="false" data-clients-sort="oldest">Mais antigos</button></div></div></article>

<% if (admin.role !== 'attendant') { %>
<% if (canEdit) { %><form class="settings-form-grid" action="/admin/settings" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<article class="settings-card"><p class="settings-eyebrow">Empresa</p><h2>Identidade do negócio</h2><label>Nome exibido<input name="company_name" required minlength="2" maxlength="80" value="<%= cfg.company_name %>"></label><label>WhatsApp principal<input name="company_whatsapp" type="tel" inputmode="tel" required data-settings-phone value="<%= cfg.company_whatsapp %>"></label><label>E-mail de contato<input name="contact_email" type="email" maxlength="160" value="<%= cfg.contact_email %>"></label><label>Nome usado nos e-mails<input name="email_sender_name" required minlength="2" maxlength="80" value="<%= cfg.email_sender_name %>"></label></article>
<article class="settings-card"><p class="settings-eyebrow">WhatsApp</p><h2>Mensagem após o pedido</h2><label>Mensagem padrão<textarea name="whatsapp_message" rows="9" required minlength="10" maxlength="1000"><%= cfg.whatsapp_message %></textarea></label><p class="settings-note">Marcadores disponíveis: <code>{nome}</code>, <code>{produto}</code>, <code>{data}</code> e <code>{cidade}</code>.</p><label class="settings-toggle"><input type="checkbox" name="auto_open_whatsapp" value="true" <%= cfg.auto_open_whatsapp === 'true' ? 'checked' : '' %>><span>Abrir o WhatsApp automaticamente depois de salvar o pedido</span></label></article>
<article class="settings-card"><p class="settings-eyebrow">Pedidos</p><h2>Regras do formulário</h2><label class="settings-toggle"><input type="checkbox" name="allow_same_day" value="true" <%= cfg.allow_same_day === 'true' ? 'checked' : '' %>><span>Permitir pedidos para hoje</span></label><label>Antecedência mínima em dias<input name="min_lead_days" type="number" inputmode="numeric" min="0" max="30" required value="<%= cfg.min_lead_days %>"></label><label>Mensagem depois do envio<textarea name="order_success_message" rows="3" required minlength="10" maxlength="240"><%= cfg.order_success_message %></textarea></label></article>
<article class="settings-card"><p class="settings-eyebrow">Notificações</p><h2>Novo pedido</h2><label class="settings-toggle"><input type="checkbox" name="notify_new_order" value="true" <%= cfg.notify_new_order === 'true' ? 'checked' : '' %>><span>Enviar e-mail quando um novo pedido for recebido</span></label><p class="settings-description">O aviso é enviado para o e-mail de contato quando o SMTP estiver configurado.</p></article>
<div class="settings-save-bar"><button class="admin-button compact" type="submit">Salvar configurações <span>→</span></button></div></form>
<% } else { %><article class="settings-card settings-readonly"><p class="settings-eyebrow">Empresa</p><h2><%= settings.company_name %></h2><p class="settings-description">As configurações do negócio podem ser alteradas por Proprietários e Administradores.</p></article><% } %>

<article class="settings-card"><p class="settings-eyebrow">E-mail</p><h2>E-mail automático</h2><span class="status-pill <%= smtpConfigured ? 'is-active' : 'is-inactive' %>"><%= smtpConfigured ? 'Configurado' : 'Não configurado' %></span><p class="settings-description"><%= smtpConfigured ? 'A senha e as credenciais permanecem protegidas no servidor.' : 'Configure o envio para recuperação de senha e notificações.' %></p><% if (smtpConfigured && canEdit) { %><form class="settings-inline-form" action="/admin/settings/email/test-existing" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-secondary-button" type="submit">Testar envio</button></form><% } %><% if (admin.role === 'owner' && environment !== 'production') { %><a class="settings-link" href="/admin/settings/email"><%= smtpConfigured ? 'Alterar configuração' : 'Configurar e-mail' %><span aria-hidden="true">→</span></a><% } %></article>
<article class="settings-card"><p class="settings-eyebrow">Segurança</p><h2>Minha conta</h2><dl class="settings-details"><div><dt>Sessões ativas</dt><dd><%= activeSessions %></dd></div><div><dt>Duração da sessão</dt><dd>2 horas</dd></div></dl><a class="settings-link" href="/admin/forgot-password">Alterar minha senha <span aria-hidden="true">→</span></a><% if (activeSessions > 1) { %><form class="settings-inline-form" action="/admin/settings/sessions/revoke" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-secondary-button" type="submit">Encerrar outras sessões</button></form><% } %></article>
<% if (['owner', 'admin'].includes(admin.role)) { %><article class="settings-card"><p class="settings-eyebrow">Suporte</p><h2>Suporte técnico</h2><span class="status-pill <%= supportStatus.active ? 'is-active' : 'is-inactive' %>"><%= supportStatus.active ? 'Ativo' : 'Desativado' %></span><% if (supportStatus.active) { %><p class="settings-description">Acesso autorizado até <%= new Date(supportStatus.until * 1000).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %>.</p><% } %><a class="settings-link" href="/admin/support">Gerenciar suporte <span aria-hidden="true">→</span></a></article><% } %>
<article class="settings-card settings-system"><p class="settings-eyebrow">Sistema</p><h2>Estado da aplicação</h2><dl class="settings-details"><div><dt>Ambiente</dt><dd><%= environment === 'production' ? 'Produção' : 'Desenvolvimento' %></dd></div><div><dt>E-mail</dt><dd><%= smtpConfigured ? 'Configurado' : 'Não configurado' %></dd></div><div><dt>Banco</dt><dd>Conectado</dd></div><div><dt>Versão</dt><dd>2.0.0</dd></div></dl><p class="settings-note">Segredos, senhas e caminhos internos nunca são exibidos.</p></article>
<article class="settings-card settings-audit"><div class="settings-audit-heading"><div><p class="settings-eyebrow">Histórico</p><h2>Atividade recente</h2></div><% if (auditEntries.length) { %><div class="audit-filters" aria-label="Filtrar atividades"><button type="button" class="active" aria-pressed="true" data-audit-filter="all">Todas</button><button type="button" aria-pressed="false" data-audit-filter="orders">Pedidos</button><button type="button" aria-pressed="false" data-audit-filter="users">Usuários</button><button type="button" aria-pressed="false" data-audit-filter="security">Segurança</button><button type="button" aria-pressed="false" data-audit-filter="support">Suporte</button></div><% } %></div><% if (!auditEntries.length) { %><p class="settings-description">Nenhuma ação registrada.</p><% } %><ul class="audit-list"><% auditEntries.forEach(function(entry) { %><li data-audit-category="<%= entry.category %>"><span class="audit-marker" aria-hidden="true"></span><div><strong><%= entry.description %></strong><time><%= entry.occurredAt %></time></div></li><% }) %></ul><p class="audit-empty" hidden>Nenhuma atividade nesta categoria.</p></article>
<% } %>
</div></main></body></html>
