<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Aprovações de produtos | Ella Sorriu</title><link rel="stylesheet" href="/style.css"><script src="/admin.js" defer></script></head>
<body class="admin-page"><%- include('partials/admin-header', { admin, csrfToken, activeSection: 'approvals' }) %><main class="admin-shell approvals-admin">
  <div class="admin-heading"><div><p class="kicker">Catálogo Ella Sorriu</p><h1>Aprovações</h1><p class="admin-description">Revise as alterações de produtos antes de publicá-las no site.</p></div><a class="admin-secondary-button" href="/admin/products">Ver produtos</a></div>
  <% if (success) { %><p class="admin-success" role="status"><%= success %></p><% } %>
  <% if (error) { %><p class="admin-alert" role="alert"><%= error %></p><% } %>
  <% if (!requests.length) { %><div class="admin-empty"><h2>Nenhuma alteração pendente</h2><p>Quando um atendente enviar uma alteração, ela aparecerá aqui para revisão.</p></div><% } %>
  <div class="approval-list"><% requests.forEach(function(request) { const after = request.after || {}; const before = request.before || {}; const labels = { name: 'Nome', description: 'Descrição', priceCents: 'Preço', categoryName: 'Categoria', available: 'Disponibilidade', active: 'Exibição no catálogo', photos: 'Fotos' }; function display(key, value) { if (key === 'priceCents') return value == null ? 'Valor sob consulta' : new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value / 100); if (key === 'available' || key === 'active') return value ? 'Sim' : 'Não'; if (key === 'photos') return (value || []).length + ' foto(s)'; return value || '—'; } %>
    <article class="approval-card">
      <header class="approval-card-header"><div><span class="status-pill is-inactive"><%= request.action === 'create' ? 'Novo produto' : request.action === 'delete' || request.action === 'deactivate' ? 'Desativação solicitada' : 'Alteração solicitada' %></span><h2><%= after.name || request.current_product_name || 'Produto' %></h2><p>Solicitado por <strong><%= request.requesterName %></strong> · <%= ({ owner: 'Proprietário', admin: 'Administrador', attendant: 'Atendente' })[request.requesterRole] || 'Equipe' %> · <%= new Date(request.requestedAt * 1000).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'short' }) %></p></div></header>
      <% if (request.action === 'create') { %><div class="approval-new-product"><p><strong>Categoria:</strong> <%= after.categoryName || '—' %></p><p><strong>Preço:</strong> <%= display('priceCents', after.priceCents) %></p><% if (after.description) { %><p><strong>Descrição:</strong> <%= after.description %></p><% } %><p><strong>Disponível:</strong> <%= display('available', after.available) %></p><div class="approval-photo-strip"><% (after.photos || []).forEach(function(photo) { %><img src="/admin/products/media/<%= encodeURIComponent(photo) %>" alt="Prévia de <%= after.name %>" loading="lazy"><% }) %></div></div><% } else { %>
        <div class="approval-comparison"><div class="approval-comparison-column"><h3>Antes</h3><% Object.keys(labels).forEach(function(key) { if (JSON.stringify(before[key]) !== JSON.stringify(after[key])) { %><p><span><%= labels[key] %></span><strong><%= display(key, before[key]) %></strong></p><% } }) %></div><div class="approval-comparison-column is-after"><h3>Depois</h3><% Object.keys(labels).forEach(function(key) { if (JSON.stringify(before[key]) !== JSON.stringify(after[key])) { %><p><span><%= labels[key] %></span><strong><%= display(key, after[key]) %></strong></p><% } }) %></div></div>
        <% if (JSON.stringify(before.photos) !== JSON.stringify(after.photos)) { %><div class="approval-photo-strip"><% (after.photos || []).forEach(function(photo) { %><img src="/admin/products/media/<%= encodeURIComponent(photo) %>" alt="Nova foto de <%= after.name %>" loading="lazy"><% }) %></div><% } %>
      <% } %>
      <div class="approval-card-actions"><form action="/admin/approvals/<%= request.id %>/reject" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="sr-only" for="review-note-<%= request.id %>">Motivo opcional da rejeição</label><input id="review-note-<%= request.id %>" name="note" maxlength="500" placeholder="Observação opcional"><button class="admin-danger" type="submit">Rejeitar</button></form><form action="/admin/approvals/<%= request.id %>/approve" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-button" type="submit">Aprovar e publicar</button></form></div>
    </article><% }) %></div>
</main></body></html>
