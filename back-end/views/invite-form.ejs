<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Adicionar pessoa | Ella Sorriu</title><link rel="stylesheet" href="/style.css"><script src="/admin.js" defer></script></head><body class="admin-page"><%- include('partials/admin-header', { admin, csrfToken, activeSection: 'team' }) %><main class="admin-shell narrow"><p class="kicker">Equipe e acessos</p><h1>Adicionar pessoa</h1><p class="admin-muted">A pessoa receberá um convite e criará a própria senha.</p><% if (error) { %><p class="admin-alert" role="alert"><%= error %></p><% } %><form class="admin-panel admin-form" action="/admin/team/invite" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome<input name="name" type="text" autocomplete="name" required minlength="2" maxlength="120"></label><label>E-mail<input name="email" type="email" autocomplete="email" required maxlength="160"></label><label>Função<select name="role" required data-admin-role-select><option value="admin">Administrador</option><option value="attendant">Atendente</option></select></label><button class="admin-button" type="submit">Criar convite <span>→</span></button></form></main></body></html>
