<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Suporte técnico | Ella Sorriu</title><link rel="stylesheet" href="/style.css"><script src="/admin.js" defer></script></head><body class="admin-page"><%- include('partials/admin-header', { admin, csrfToken, activeSection: 'support' }) %><main class="admin-shell"><div class="admin-heading"><div><p class="kicker">Controle do Proprietário</p><h1>Suporte técnico</h1></div><a class="admin-button compact" href="/admin/support/invite">+ Adicionar suporte</a></div><p class="admin-muted">Não existe acesso oculto. Toda conta de suporte aparece aqui e só entra durante o período autorizado.</p><div class="team-grid"><% if (!supportAccounts.length) { %><section class="admin-empty"><h2>Nenhuma conta de suporte.</h2><p>Crie um convite quando desejar cadastrar o responsável técnico.</p></section><% } %><% supportAccounts.forEach(function(member) { %><article class="team-card"><div class="team-card-heading"><div><h2><%= member.name %></h2><p><%= member.email %></p></div><span class="status-pill <%= member.effectiveActive ? 'is-active' : 'is-inactive' %>"><%= member.effectiveActive ? 'Autorizado' : 'Bloqueado' %></span></div><p><% if (member.effectiveActive) { %>Acesso autorizado até <strong><%= new Date(member.support_access_until * 1000).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></strong>.<% } else { %>O suporte não pode entrar no painel.<% } %></p><% if (member.effectiveActive) { %><form action="/admin/support/<%= member.id %>/disable" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-danger" type="submit">Cancelar autorização</button></form><% } else { %><form class="support-authorize" action="/admin/support/<%= member.id %>/authorize" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Autorizar por<select name="hours"><option value="1">1 hora</option><option value="8">8 horas</option><option value="24" selected>24 horas</option><option value="168">7 dias</option></select></label><button class="admin-button" type="submit">Autorizar suporte</button></form><% } %></article><% }) %></div></main></body></html>
