<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Clientes | Ella Sorriu</title><link rel="stylesheet" href="/style.css"><script src="/admin.js" defer></script></head><body class="admin-page"><%- include('partials/admin-header', { admin, csrfToken, activeSection: 'clients' }) %><main class="admin-shell"><div class="admin-heading"><div><p class="kicker">Relacionamento</p><h1>Clientes</h1></div><span><%= clients.length %> <%= clients.length === 1 ? 'cliente' : 'clientes' %></span></div>
<% if (!clients.length) { %><section class="admin-empty"><h2>Nenhum cliente por aqui.</h2><p>Os contatos aparecem após o primeiro pedido.</p></section><% } else { %><div class="admin-table-wrap"><table class="admin-table" data-clients-table><thead><tr><th>Cliente</th><th>Contato</th><th>Cidade</th><th>Pedidos</th><th>Último pedido</th><th>Ação</th></tr></thead><tbody><% clients.forEach(function(client) { %><tr data-client-row data-client-updated="<%= new Date(client.last_order_at + 'Z').getTime() %>"><td data-label="Cliente"><strong><%= client.nome %></strong></td><td data-label="Contato"><span data-phone-display><%= client.whatsapp %></span><small><%= client.email || 'E-mail não informado' %></small></td><td data-label="Cidade"><%= client.cidade %></td><td data-label="Pedidos"><%= client.order_count %></td><td data-label="Último pedido"><%= new Date(client.last_order_at + 'Z').toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></td><td data-label="Ação"><% if (client.whatsappUrl) { %><a class="admin-row-link" href="<%= client.whatsappUrl %>" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><% } %></td></tr><% }) %></tbody></table></div><% } %></main></body></html>
