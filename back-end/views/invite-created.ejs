<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Convite criado | Ella Sorriu</title><link rel="stylesheet" href="/style.css"><script src="/admin.js" defer></script></head><body class="admin-page"><%- include('partials/admin-header', { admin, csrfToken, activeSection: 'team' }) %><main class="admin-shell narrow"><section class="admin-panel"><p class="kicker">Convite criado</p><h1>Pronto para enviar.</h1><p class="admin-muted"><% if (emailSent) { %>O convite foi enviado para <strong><%= email %></strong>.<% } else { %>Como o e-mail automático não está configurado, copie o link e envie para <strong><%= email %></strong>. Ele expira em 24 horas.<% } %></p><label>Link do convite<input id="invite-link" type="text" value="<%= inviteUrl %>" readonly></label><button class="admin-button" type="button" data-copy-invite>Copiar link do convite <span>⧉</span></button><p class="copy-feedback" role="status" hidden>Link copiado.</p><a class="admin-help-link" href="/admin/team">Voltar para Equipe e acessos</a></section></main></body></html>
