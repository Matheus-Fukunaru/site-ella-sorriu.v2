<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Adicionar suporte | Ella Sorriu</title><link rel="stylesheet" href="/style.css"><script src="/admin.js" defer></script></head><body class="admin-page"><%- include('partials/admin-header', { admin, csrfToken, activeSection: 'support' }) %><main class="admin-shell narrow"><p class="kicker">Suporte técnico</p><h1>Criar convite de suporte</h1><p class="admin-muted">Esta conta ficará bloqueada até o Proprietário autorizar um período de acesso.</p><% if (error) { %><p class="admin-alert" role="alert"><%= error %></p><% } %><form class="admin-panel admin-form" action="/admin/support/invite" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="role" value="support"><label>Nome<input name="name" type="text" autocomplete="name" required minlength="2" maxlength="120"></label><label>E-mail<input name="email" type="email" autocomplete="email" required maxlength="160"></label><button class="admin-button" type="submit">Criar convite <span>→</span></button></form></main></body></html>
