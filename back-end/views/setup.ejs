<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Primeiro acesso | Ella Sorriu</title><link rel="stylesheet" href="/style.css"></head>
<body class="admin-page admin-login-page"><main class="admin-login"><a class="admin-brand" href="/"><span>Ella Sorriu</span><small>Configuração segura</small></a><section class="admin-panel"><p class="kicker">Primeiro acesso</p><h1>Crie a conta proprietária.</h1><p class="admin-muted">Este link funciona somente uma vez. Depois, a configuração inicial será bloqueada.</p><% if (error) { %><p class="admin-alert" role="alert"><%= error %></p><% } %><form action="/admin/setup/<%= token %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nome<input name="name" type="text" autocomplete="name" required minlength="2" maxlength="120"></label><label>E-mail<input name="email" type="email" autocomplete="username" required maxlength="160"></label><label>Senha<input name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="72"></label><label>Confirmar senha<input name="password_confirmation" type="password" autocomplete="new-password" required minlength="12" maxlength="72"></label><button class="admin-button" type="submit">Criar meu acesso <span>→</span></button></form></section></main></body></html>
