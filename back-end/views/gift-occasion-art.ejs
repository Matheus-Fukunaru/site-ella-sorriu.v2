  'Amizade':'cups', 'Dia das Mães':'flower', 'Dia dos Pais':'compass', 'Dia das Crianças':'kite',
  'Agradecimento':'gift', 'Formatura':'graduation', 'Natal':'tree', 'Páscoa':'egg',
  'Boa sorte':'clover', 'Novo emprego':'briefcase'
