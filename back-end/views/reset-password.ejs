<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Nova senha | Ella Sorriu</title><link rel="stylesheet" href="/style.css"><script src="/admin.js" defer></script></head>
<body class="admin-page admin-login-page"><main class="admin-login"><a class="admin-brand" href="/"><span>Ella Sorriu</span><small>Recuperação de acesso</small></a><section class="admin-panel"><p class="kicker">Nova senha</p><h1>Proteja sua conta.</h1><p class="admin-muted">Use pelo menos 12 caracteres e não reutilize senhas de outros serviços.</p><% if (error) { %><p class="admin-alert" role="alert"><%= error %></p><% } %><form action="/admin/reset-password/<%= token %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nova senha<input name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="72"></label><label>Confirmar senha<input name="password_confirmation" type="password" autocomplete="new-password" required minlength="12" maxlength="72"></label><button class="admin-button" type="submit">Atualizar senha <span>→</span></button></form></section></main></body></html>
